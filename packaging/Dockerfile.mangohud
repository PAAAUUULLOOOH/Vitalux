# syntax=docker/dockerfile:1
# glibc 2.31 also supports Steam's older Soldier runtime. No host installation.
FROM ubuntu:20.04@sha256:8feb4d8ca5354def3d8fce243717141ce31e2c428701f6682bd2fafe15388214
ARG DEBIAN_FRONTEND=noninteractive
RUN --mount=type=secret,id=proxy_ca,required=true,mode=0444 --mount=type=cache,target=/var/cache/apt,sharing=locked \
    rm -f /etc/apt/apt.conf.d/docker-clean && \
    sed -i 's|http://archive.ubuntu.com|https://archive.ubuntu.com|g; s|http://security.ubuntu.com|https://security.ubuntu.com|g' /etc/apt/sources.list && \
    dpkg --add-architecture i386 && \
    apt-get -o Acquire::Retries=4 -o Acquire::https::Timeout=45 -o Acquire::https::CaInfo=/run/secrets/proxy_ca update && \
    apt-get -o Acquire::Retries=4 -o Acquire::https::Timeout=45 -o Acquire::https::CaInfo=/run/secrets/proxy_ca install -y --no-install-recommends \
      ca-certificates python3 python3-pip ninja-build pkg-config cmake git \
      gcc-multilib g++-multilib binutils patchelf glslang-tools \
      libx11-dev libx11-dev:i386 libxkbcommon-dev libxkbcommon-dev:i386 \
      libwayland-dev libwayland-dev:i386 libdbus-1-dev libdbus-1-dev:i386 \
      libxnvctrl-dev mesa-common-dev libgl-dev libgl-dev:i386 && \
    rm -rf /var/lib/apt/lists/*
RUN --mount=type=secret,id=proxy_ca,required=true,mode=0444 \
    PIP_CERT=/run/secrets/proxy_ca python3 -m pip install --no-cache-dir meson==1.2.3 Mako==1.3.10 MarkupSafe==2.1.5 patchelf==0.17.2.4
WORKDIR /src
COPY . /src
RUN --mount=type=secret,id=proxy_ca,required=true,mode=0444 --mount=type=cache,target=/src/build64 --mount=type=cache,target=/src/build32 \
    SSL_CERT_FILE=/run/secrets/proxy_ca REQUESTS_CA_BUNDLE=/run/secrets/proxy_ca \
    sh /src/vitalux-build.sh
